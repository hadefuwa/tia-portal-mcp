<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>TiaOpennessMcpServer</RootNamespace>
    <AssemblyName>TiaPortalDashboard</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      When TiaVersion builds override BaseIntermediateOutputPath (obj\V20\,
      obj\V21\, …) the SDK's default source-glob exclude only covers the
      CURRENT run's obj dir, not sibling version dirs left over from other
      builds. Without this, e.g. a V21 build picks up obj\V20\...\*.cs as
      stray source and fails with "duplicate assembly attribute".
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console"     Version="8.0.1" />
    <PackageReference Include="System.Text.Json"                         Version="8.0.5" />
    <PackageReference Include="Microsoft.Web.WebView2"                   Version="1.0.2651.64" />
  </ItemGroup>

  <!--
    TIA Portal's Openness API is version-specific and NOT drop-in compatible
    across major versions:
      - V20 and earlier ship one monolithic Siemens.Engineering.dll (+ an
        unused classic-HMI Siemens.Engineering.Hmi.dll) directly under
        PublicAPI\{v}.
      - V21 split it into several assemblies under PublicAPI\{v}\net48\,
        renaming the core one to Siemens.Engineering.Base.dll and moving the
        HmiUnified (WinCC Unified) types this project uses into
        Siemens.Engineering.WinCCUnified.dll.
    Both DLL sets are strongly named with version-specific identities, so a
    single compiled binary can't satisfy both at runtime — pick which one to
    build against with -p:TiaVersion=V20 (default) or -p:TiaVersion=V21.
    See Program.cs's assembly-path detection for the runtime side (it finds
    whichever TIA Portal version is actually installed/running).
  -->
  <PropertyGroup>
    <TiaVersion Condition="'$(TiaVersion)' == ''">V20</TiaVersion>
    <DefineConstants>$(DefineConstants);TIA_$(TiaVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TiaVersion)' == 'V20'">
    <Reference Include="Siemens.Engineering">
      <HintPath>$(PROGRAMFILES)\Siemens\Automation\Portal V20\PublicAPI\V20\Siemens.Engineering.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Siemens.Engineering.Hmi">
      <HintPath>$(PROGRAMFILES)\Siemens\Automation\Portal V20\PublicAPI\V20\Siemens.Engineering.Hmi.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TiaVersion)' == 'V21'">
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>$(PROGRAMFILES)\Siemens\Automation\Portal V21\PublicAPI\V21\net48\Siemens.Engineering.Base.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Siemens.Engineering.WinCCUnified">
      <HintPath>$(PROGRAMFILES)\Siemens\Automation\Portal V21\PublicAPI\V21\net48\Siemens.Engineering.WinCCUnified.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Siemens.Engineering.Step7">
      <HintPath>$(PROGRAMFILES)\Siemens\Automation\Portal V21\PublicAPI\V21\net48\Siemens.Engineering.Step7.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="dashboard.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
