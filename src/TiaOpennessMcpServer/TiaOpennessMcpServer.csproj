<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>TiaOpennessMcpServer</RootNamespace>
    <AssemblyName>TiaPortalDashboard</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Pass -p:TiaVersion=19, 20 or 21 (required, no default) -->
    <DefineConstants>$(DefineConstants);TIA_V$(TiaVersion)</DefineConstants>
    <TiaApiDir>$(PROGRAMFILES)\Siemens\Automation\Portal V$(TiaVersion)\PublicAPI\V$(TiaVersion)</TiaApiDir>
    <!-- Separate output and intermediate folders per version, so switching never needs a clean -->
    <OutputPath>bin\V$(TiaVersion)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\V$(TiaVersion)\$(Configuration)\</IntermediateOutputPath>
    <!-- Keep every obj\V* folder out of the source glob, so a build never picks up another version's generated .cs files -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;obj/**;bin\**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console"     Version="8.0.1" />
    <PackageReference Include="System.Text.Json"                         Version="8.0.5" />
    <PackageReference Include="Microsoft.Web.WebView2"                   Version="1.0.2651.64" />
  </ItemGroup>

  <!--
    TIA Portal's Openness API is version-specific and NOT drop-in compatible
    across major versions:
      - V19 and V20 ship one monolithic Siemens.Engineering.dll (+ an unused
        classic-HMI Siemens.Engineering.Hmi.dll) directly under PublicAPI\{v}.
      - V21 split it into several assemblies under PublicAPI\{v}\net48\,
        renaming the core one to Siemens.Engineering.Base.dll and moving the
        HmiUnified (WinCC Unified) types this project uses into
        Siemens.Engineering.WinCCUnified.dll.
    The DLLs are strongly named with version-specific identities, so one
    compiled binary can't satisfy several versions: pick one with
    -p:TiaVersion=19, 20 or 21. Program.cs / TiaVersion.cs find the matching
    installation at run time.
  -->
  <ItemGroup Condition="'$(TiaVersion)' == '19' Or '$(TiaVersion)' == '20'">
    <Reference Include="Siemens.Engineering">
      <HintPath>$(TiaApiDir)\Siemens.Engineering.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Siemens.Engineering.Hmi">
      <HintPath>$(TiaApiDir)\Siemens.Engineering.Hmi.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TiaVersion)' == '21'">
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>$(TiaApiDir)\net48\Siemens.Engineering.Base.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Siemens.Engineering.WinCCUnified">
      <HintPath>$(TiaApiDir)\net48\Siemens.Engineering.WinCCUnified.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Siemens.Engineering.Step7">
      <HintPath>$(TiaApiDir)\net48\Siemens.Engineering.Step7.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="dashboard.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- No default on purpose: the TIA version must be chosen explicitly. -->
  <Target Name="RequireTiaVersion" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="'$(TiaVersion)' != '19' And '$(TiaVersion)' != '20' And '$(TiaVersion)' != '21'"
           Text="Set the TIA Portal version: dotnet build -p:TiaVersion=19 (or 20 or 21). Got '$(TiaVersion)'." />
  </Target>
</Project>
