<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>TiaOpennessMcpServer</RootNamespace>
    <AssemblyName>TiaPortalDashboard</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Pass -p:TiaVersion=19 or -p:TiaVersion=20 (required, no default) -->
    <DefineConstants>$(DefineConstants);TIA_V$(TiaVersion)</DefineConstants>
    <TiaApiDir>$(PROGRAMFILES)\Siemens\Automation\Portal V$(TiaVersion)\PublicAPI\V$(TiaVersion)</TiaApiDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console"     Version="8.0.1" />
    <PackageReference Include="System.Text.Json"                         Version="8.0.5" />
    <PackageReference Include="Microsoft.Web.WebView2"                   Version="1.0.2651.64" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Siemens.Engineering">
      <HintPath>$(TiaApiDir)\Siemens.Engineering.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Siemens.Engineering.Hmi">
      <HintPath>$(TiaApiDir)\Siemens.Engineering.Hmi.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="dashboard.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>


  <!-- No default on purpose: the TIA version must be chosen explicitly. -->
  <Target Name="RequireTiaVersion" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="'$(TiaVersion)' != '19' And '$(TiaVersion)' != '20'"
           Text="Set the TIA Portal version: dotnet build -p:TiaVersion=19 (or 20). Got '$(TiaVersion)'." />
  </Target>
</Project>
